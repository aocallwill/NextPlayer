 7556 A97D
 7557 A97D              ;***************************
 7558 A97D              ;***************************
 7559 A97D              ;***************************
 7560 A97D              ;***************************
 7561 A97D              ;***************************
 7562 A97D              ;***************************
 7563 A97D              ;***************************
 7564 A97D              ;***************************
 7565 A97D              ;***************************
 7566 A97D              ;***************************
 7567 A97D              ;***************************
 7568 A97D              ;Universal PT2'n'PT3 Turbo Sound player for ZX Spectrum
 7569 A97D              ;(c)2004-2007 S.V.Bulba <vorobey@mail.khstu.ru>
 7570 A97D              ;Specially for AlCo
 7571 A97D              ;http://bulba.untergrund.net/ (http://bulba.at.kz/)
 7572 A97D              	MODULE VTPL
 7573 A97D              ;Release number
 7574 A97D              Release EQU "0"
 7575 A97D              ;Conditional assembly
 7576 A97D              ;1) Current position counters at (Vars1+0) and (Vars2+0)
 7577 A97D              CurPosCounter=0
 7578 A97D              ;2) Allow channels allocation bits at (START+10)
 7579 A97D              ACBBAC=0
 7580 A97D              ;3) Allow loop checking and disabling
 7581 A97D              LoopChecker=1
 7582 A97D              ;4) Insert official identificator
 7583 A97D              Id=0
 7584 A97D              ;5) Set IY for correct return to ZX Basic
 7585 A97D              Basic=1
 7586 A97D
 7587 A97D              ;Features
 7588 A97D              ;--------
 7589 A97D              ;-Can be compiled at any address (i.e. no need rounding ORG
 7590 A97D              ; address).
 7591 A97D              ;-Variables (VARS) can be located at any address (not only after
 7592 A97D              ; code block).
 7593 A97D              ;-INIT subprogram checks PT3-module version and rightly
 7594 A97D              ; generates both note and volume tables outside of code block
 7595 A97D              ; (in VARS).
 7596 A97D              ;-Two portamento (spc. command 3xxx) algorithms (depending of
 7597 A97D              ; PT3 module version).
 7598 A97D              ;-New 1.XX and 2.XX special command behaviour (only for PT v3.7
 7599 A97D              ; and higher).
 7600 A97D              ;-Any Tempo value are accepted (including Tempo=1 and Tempo=2).
 7601 A97D              ;-TS modes: 2xPT3, 2xPT2 and PT v3.7 TS standard.
 7602 A97D              ;-Fully compatible with Ay_Emul PT3 and PT2 players codes.
 7603 A97D              ;-See also notes at the end of this source code.
 7604 A97D
 7605 A97D              ;Limitations
 7606 A97D              ;-----------
 7607 A97D              ;-Can run in RAM only (self-modified code is used).
 7608 A97D              ;-PT2 position list must be end by #FF marker only.
 7609 A97D
 7610 A97D              ;Warning!!! PLAY subprogram can crash if no module are loaded
 7611 A97D              ;into RAM or INIT subprogram was not called before.
 7612 A97D
 7613 A97D              ;Call MUTE or INIT one more time to mute sound after stopping
 7614 A97D              ;playing
 7615 A97D
 7616 A97D              ;Test codes (commented)
 7617 A97D              ;	LD A,32 ;SinglePT3(TS if TSPT3.7),ABC,Looped
 7618 A97D              ;	LD (START+10),A
 7619 A97D              ;	LD HL,#8000 ;Mod1
 7620 A97D              ;	LD DE,#A000 ;Mod2 (optional)
 7621 A97D              ;	CALL START+3
 7622 A97D              ;	EI
 7623 A97D              ;_LP	HALT
 7624 A97D              ;	CALL START+5
 7625 A97D              ;	XOR A
 7626 A97D              ;	IN A,(#FE)
 7627 A97D              ;	CPL
 7628 A97D              ;	AND 15
 7629 A97D              ;	JR Z,_LP
 7630 A97D              ;	JR START+8
 7631 A97D
 7632 A97D              TonA	EQU 0
 7633 A97D              TonB	EQU 2
 7634 A97D              TonC	EQU 4
 7635 A97D              Noise	EQU 6
 7636 A97D              Mixer	EQU 7
 7637 A97D              AmplA	EQU 8
 7638 A97D              AmplB	EQU 9
 7639 A97D              AmplC	EQU 10
 7640 A97D              Env	EQU 11
 7641 A97D              EnvTp	EQU 13
 7642 A97D
 7643 A97D              ;Entry and other points
 7644 A97D              ;START initialize playing of modules at MDLADDR (single module)
 7645 A97D              ;START+3 initialization with module address in HL and DE (TS)
 7646 A97D              ;START+5 play one quark
 7647 A97D              ;START+8 mute
 7648 A97D              ;START+10 setup and status flags
 7649 A97D
 7650 A97D              START:
 7651 A97D 21 32 BD     	LD HL,songdata ;DE - address of 2nd module for TS
 7652 A980 18 3C        	JR INIT
 7653 A982 C3 E1 B1     	JP PLAY
 7654 A985 18 25        	JR MUTE
 7655 A987 10           SETUP	DB %00010000 ;set bit0, if you want to play without looping
 7656 A988              	     ;(optional);
 7657 A988              	     ;set bit1 for PT2 and reset for PT3 before
 7658 A988              	     ;calling INIT;
 7659 A988              	     ;bits2-3: %00-ABC, %01-ACB, %10-BAC (optional);
 7660 A988              	     ;bits4-5: %00-no TS, %01-2 modules TS, %10-
 7661 A988              	     ;autodetect PT3 TS-format by AlCo (PT 3.7+);
 7662 A988              	     ;Remark: old PT3 TS-format by AlCo (PT 3.6) is not
 7663 A988              	     ;documented and must be converted to new standard.
 7664 A988              	     ;bit6 is set each time, when loop point of 2nd TS
 7665 A988              	     ;module is passed (optional).
 7666 A988              	     ;bit7 is set each time, when loop point of 1st TS
 7667 A988              	     ;or of single module is passed (optional).
 7668 A988
 7669 A988              ;Identifier
 7670 A988              	IF Id
 7671 A988 ~            	DB "=UniPT2/PT3/TS-Player r.",Release,"="
 7672 A988              	ENDIF
 7673 A988
 7674 A988              	IF LoopChecker
 7675 A988 21 87 A9     CHECKLP	LD HL,SETUP
 7676 A98B FD CB 9E 46  	BIT 0,(IY-100+VRS.ModNum)
 7677 A98F 28 04        	JR Z,CHL1
 7678 A991 CB F6        	SET 6,(HL)
 7679 A993 18 02        	JR CHL2
 7680 A995 CB FE        CHL1	SET 7,(HL)
 7681 A997 CB 46        CHL2	BIT 0,(HL)
 7682 A999 C8           	RET Z
 7683 A99A E1           	POP HL
 7684 A99B FD 34 09     	INC (IY-100+VRS.DelyCnt)
 7685 A99E FD 34 BA     	INC (IY-100+VRS.ChanA+CHP.NtSkCn)
 7686 A9A1 AF           	XOR A
 7687 A9A2 FD 77 1D     	LD (IY-100+VRS.AYREGS+AmplA),A
 7688 A9A5 FD 77 1E     	LD (IY-100+VRS.AYREGS+AmplB),A
 7689 A9A8 FD 77 1F     	LD (IY-100+VRS.AYREGS+AmplC),A
 7690 A9AB C9           	RET
 7691 A9AC              	ENDIF
 7692 A9AC
 7693 A9AC AF           MUTE: XOR A
 7694 A9AD 67           	LD H,A
 7695 A9AE 6F           	LD L,A
 7696 A9AF 32 36 B3     	LD (VARS1+VRS.AYREGS+AmplA),A
 7697 A9B2 22 37 B3     	LD (VARS1+VRS.AYREGS+AmplB),HL
 7698 A9B5 32 BD B3     	LD (VARS2+VRS.AYREGS+AmplA),A
 7699 A9B8 22 BE B3     	LD (VARS2+VRS.AYREGS+AmplB),HL
 7700 A9BB C3 F9 B1     	JP ROUT
 7701 A9BE
 7702 A9BE              INIT:
 7703 A9BE              ;HL - AddressOfModule
 7704 A9BE              ;DE - AddresOf2ndModule
 7705 A9BE D5           	PUSH DE
 7706 A9BF E5           	PUSH HL
 7707 A9C0 21 B4 B2     	LD HL,VARS
 7708 A9C3 36 00        	LD (HL),0
 7709 A9C5 11 B5 B2     	LD DE,VARS+1
 7710 A9C8 01 0E 01     	LD BC,VAR0END-VARS-1
 7711 A9CB ED B0        	LDIR
 7712 A9CD 23           	INC HL
 7713 A9CE 22 17 B3     	LD (VARS1+VRS.AdInPtA),HL ;ptr to zero
 7714 A9D1 22 9E B3     	LD (VARS2+VRS.AdInPtA),HL
 7715 A9D4
 7716 A9D4 E1           	POP HL
 7717 A9D5 FD 21 19 B3  	LD IY,VARS1+100
 7718 A9D9 3A 87 A9     	LD A,(START+10)
 7719 A9DC E6 02        	AND 2
 7720 A9DE C2 67 AA     	JP NZ,I_PT2
 7721 A9E1
 7722 A9E1 CD B4 AB     	CALL INITPT3
 7723 A9E4 21 18 1F     	LD HL,(e_-SamCnv-2)*256+#18
 7724 A9E7 22 87 AF     	LD (SamCnv),HL
 7725 A9EA 3E BA        	LD A,#BA
 7726 A9EC 32 52 AF     	LD (OrnCP),A
