   69+807D              ; =============================================================================
   70+807D              ; MOUSE_UpdateSpr – refresh sprite + latch tlačítek (uchovává všechny registry)
   71+807D              ; =============================================================================
   72+807D              MOUSE_UpdateSpr:
   73+807D F5                   push af
   74+807E C5                   push bc
   75+807F D5                   push de
   76+8080 E5                   push hl
   77+8081
   78+8081 CD C0 7F             call MOUSE                  ; A = CONTRB, HL = COORD (L=X, H=Y)
   79+8084 47                   ld b, a                     ; B = aktuální stav tlačítek
   80+8085
   81+8085                      ; Latch: MOUSE_TLAC = MOUSE_TLAC OR aktuální tlačítka
   82+8085                      ; (tlačítko zůstane aktivní dokud ho nespotřebuje obsluha)
   83+8085                         ; Latch: OR aktualni tlacitka do MOUSE_TLAC
   84+8085 78                   ld a, b
   85+8086 B7                   or a
   86+8087 28 07                jr z, .noBtn
   87+8089 3A 46 80             ld a, (MOUSE_TLAC)
   88+808C B0                   or b
   89+808D 32 46 80             ld (MOUSE_TLAC), a
   90+8090              .noBtn:
   91+8090 ED 91 34 00          nextreg $34, 0
   92+8094
   93+8094 7D                   ld a, l
   94+8095 57                   ld d, a
   95+8096 1E 02                ld e, 2
   96+8098 ED 30                mul d, e
   97+809A 7B                   ld a, e
   98+809B 32 B0 80             ld (MUSPR_X+3), a
   99+809E
  100+809E 3A B8 80             ld a, (MUSPR_XH+3)
  101+80A1 CB 87                res 0, a
  102+80A3 B2                   or d
  103+80A4 CB FF                set 7, a
  104+80A6 32 B8 80             ld (MUSPR_XH+3), a
  105+80A9
  106+80A9 7C                   ld a, h
  107+80AA 32 B4 80             ld (MUSPR_Y+3), a
  108+80AD
  109+80AD ED 91 35 00  MUSPR_X:  nextreg $35, 0
  110+80B1 ED 91 36 00  MUSPR_Y:  nextreg $36, 0
  111+80B5 ED 91 37 08  MUSPR_XH: nextreg $37, %00001000
  112+80B9 ED 91 38 80            nextreg $38, %10000000
  113+80BD
  114+80BD E1                   pop hl
  115+80BE D1                   pop de
  116+80BF C1                   pop bc
  117+80C0 F1                   pop af
  118+80C1 C9                   ret
