 7644 A97D
 7645 A97D              ;***************************
 7646 A97D              ;***************************
 7647 A97D              ;***************************
 7648 A97D              ;***************************
 7649 A97D              ;***************************
 7650 A97D              ;***************************
 7651 A97D              ;***************************
 7652 A97D              ;***************************
 7653 A97D              ;***************************
 7654 A97D              ;***************************
 7655 A97D              ;***************************
 7656 A97D              ;Universal PT2'n'PT3 Turbo Sound player for ZX Spectrum
 7657 A97D              ;(c)2004-2007 S.V.Bulba <vorobey@mail.khstu.ru>
 7658 A97D              ;Specially for AlCo
 7659 A97D              ;http://bulba.untergrund.net/ (http://bulba.at.kz/)
 7660 A97D              	MODULE VTPL
 7661 A97D              ;Release number
 7662 A97D              Release EQU "0"
 7663 A97D              ;Conditional assembly
 7664 A97D              ;1) Current position counters at (Vars1+0) and (Vars2+0)
 7665 A97D              CurPosCounter=0
 7666 A97D              ;2) Allow channels allocation bits at (START+10)
 7667 A97D              ACBBAC=0
 7668 A97D              ;3) Allow loop checking and disabling
 7669 A97D              LoopChecker=1
 7670 A97D              ;4) Insert official identificator
 7671 A97D              Id=0
 7672 A97D              ;5) Set IY for correct return to ZX Basic
 7673 A97D              Basic=1
 7674 A97D
 7675 A97D              ;Features
 7676 A97D              ;--------
 7677 A97D              ;-Can be compiled at any address (i.e. no need rounding ORG
 7678 A97D              ; address).
 7679 A97D              ;-Variables (VARS) can be located at any address (not only after
 7680 A97D              ; code block).
 7681 A97D              ;-INIT subprogram checks PT3-module version and rightly
 7682 A97D              ; generates both note and volume tables outside of code block
 7683 A97D              ; (in VARS).
 7684 A97D              ;-Two portamento (spc. command 3xxx) algorithms (depending of
 7685 A97D              ; PT3 module version).
 7686 A97D              ;-New 1.XX and 2.XX special command behaviour (only for PT v3.7
 7687 A97D              ; and higher).
 7688 A97D              ;-Any Tempo value are accepted (including Tempo=1 and Tempo=2).
 7689 A97D              ;-TS modes: 2xPT3, 2xPT2 and PT v3.7 TS standard.
 7690 A97D              ;-Fully compatible with Ay_Emul PT3 and PT2 players codes.
 7691 A97D              ;-See also notes at the end of this source code.
 7692 A97D
 7693 A97D              ;Limitations
 7694 A97D              ;-----------
 7695 A97D              ;-Can run in RAM only (self-modified code is used).
 7696 A97D              ;-PT2 position list must be end by #FF marker only.
 7697 A97D
 7698 A97D              ;Warning!!! PLAY subprogram can crash if no module are loaded
 7699 A97D              ;into RAM or INIT subprogram was not called before.
 7700 A97D
 7701 A97D              ;Call MUTE or INIT one more time to mute sound after stopping
 7702 A97D              ;playing
 7703 A97D
 7704 A97D              ;Test codes (commented)
 7705 A97D              ;	LD A,32 ;SinglePT3(TS if TSPT3.7),ABC,Looped
 7706 A97D              ;	LD (START+10),A
 7707 A97D              ;	LD HL,#8000 ;Mod1
 7708 A97D              ;	LD DE,#A000 ;Mod2 (optional)
 7709 A97D              ;	CALL START+3
 7710 A97D              ;	EI
 7711 A97D              ;_LP	HALT
 7712 A97D              ;	CALL START+5
 7713 A97D              ;	XOR A
 7714 A97D              ;	IN A,(#FE)
 7715 A97D              ;	CPL
 7716 A97D              ;	AND 15
 7717 A97D              ;	JR Z,_LP
 7718 A97D              ;	JR START+8
 7719 A97D
 7720 A97D              TonA	EQU 0
 7721 A97D              TonB	EQU 2
 7722 A97D              TonC	EQU 4
 7723 A97D              Noise	EQU 6
 7724 A97D              Mixer	EQU 7
 7725 A97D              AmplA	EQU 8
 7726 A97D              AmplB	EQU 9
 7727 A97D              AmplC	EQU 10
 7728 A97D              Env	EQU 11
