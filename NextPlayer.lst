  121+80C2              ; MOUSE_RdWheel
  122+80C2              ; =============================================================================
  123+80C2              MOUSE_RdWheel:
  124+80C2 01 DF FA             ld bc, MOUSE_PORT_BTN
  125+80C5 ED 78                in a, (c)
  126+80C7 E6 F0                and $F0
  127+80C9 0F                   rrca
  128+80CA 0F                   rrca
  129+80CB 0F                   rrca
  130+80CC 0F                   rrca
