 4055 7FB8              			INCLUDE "mouse_support.asm"
# file opened: mouse_support.asm
    1+7FB8              ; =============================================================================
    2+7FB8              ; mouse_support.asm  –  podpora Kempston myši pro NextPlayer
    3+7FB8              ; Autor: Shrek/MB Maniax  v0.9
    4+7FB8              ;
    5+7FB8              ; ZMĚNY v0.9:
    6+7FB8              ;  - MOUSE_PLAY_TICK přesunut ZA keysetup (byl před ním → keysetup přepisoval
    7+7FB8              ;    klavesa kterou MOUSE_PLAY_TICK nastavil)
    8+7FB8              ;  - Zpřesnění X hranic seznamu souborů (bylo 1..159, nyní 32..135)
    9+7FB8              ;    Zabrání kliknutí mimo levý panel (pravá část obrazovky, border)
   10+7FB8              ;  - MOUSE_PLAY_TICK vynuluje MOUSE_TLAC jen jednou, ne dvakrát
   11+7FB8              ; =============================================================================
   12+7FB8
   13+7FB8              MOUSE_PORT_BTN  equ $FADF
   14+7FB8
   15+7FB8              ; CSpect border offsets:
   16+7FB8              ; Nahoře:  32px → COORD+1 = ZX_pixel_Y + 32
   17+7FB8              ; Vlevo:   24px → COORD+0 = ZX_pixel_X + 24
   18+7FB8              MOUSE_BORDER_Y  equ 32
   19+7FB8              MOUSE_BORDER_X  equ 32
   20+7FB8
   21+7FB8              ; Oblast levého panelu (seznam souborů):
   22+7FB8              ; ZX pixel X: 32..111 (chars 4..13, šířka 10 chars = jméno souboru)
   23+7FB8              ; ZX pixel Y: 16..159 (chars 2..19, výška 18 řádků)
   24+7FB8              ; + border offsets:
   25+7FB8              MOUSE_LIST_Y0   equ 16 + MOUSE_BORDER_Y     ; = 48
   26+7FB8              MOUSE_LIST_Y1   equ 159 + MOUSE_BORDER_Y    ; = 191
   27+7FB8              MOUSE_LIST_X0   equ 24 ; + MOUSE_BORDER_X       ; = 40  (zacý okraj panelu)
   28+7FB8              MOUSE_LIST_X1   equ 68 ;+ MOUSE_BORDER_X    ; = 143 (pravy okraj leveho panelu)
   29+7FB8
   30+7FB8              ; Proměnné
   31+7FB8 00           MOUSE_TLAC      defb 0
   32+7FB9 00           MOUSE_WOLD      defb 0
   33+7FBA 00           MOUSE_DCNT      defb 0
