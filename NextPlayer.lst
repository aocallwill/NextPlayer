 4141 7FC0              ; --- Mouse driver + support (za font: aby font zustal pod $8000) ---
 4142 7FC0              			INCLUDE "driver.a80"
# file opened: driver.a80
    1+7FC0              ;   Nejprve zavolat KOREKCE s parametrama:
    2+7FC0              ;           INPUT : L=new X-axis(0-255) / H=new Y-axis(0-191)
    3+7FC0              ;           OUTPUT: none
    4+7FC0              ;
    5+7FC0              ;
    6+7FC0              ;   Zavolat MOUSE - zjištění nových souřadnic:
    7+7FC0              ;           INPUT : none
    8+7FC0              ;           OUTPUT: A=buttons status (*) + modify mouse positions (*)
    9+7FC0              ;
   10+7FC0              ;           register L or (coord+0) = 1B new x-axis window position(absolute)
   11+7FC0              ;           register H or (coord+1) = 1B new y-axis window position(absolute)
   12+7FC0              ;
   13+7FC0              ;           register A or (contrb)  = 1B new mouse buttons (D0=right button,D1=left button,D2=middle button) - 0=inactive/1=active button
   14+7FC0              ;
   15+7FC0              ;           register E or (oldco+0) = 1B previous(old) x-axis window position(absolute)
   16+7FC0              ;           register D or (oldco+1) = 1B previous(old) y-axis window position(absolute)
   17+7FC0              ;
   18+7FC0              ;           register BC is modified, after return from driver will contain value #FADF.
   19+7FC0
   20+7FC0
   21+7FC0              XMAX     equ  153
   22+7FC0              XMIN     equ  0
   23+7FC0
   24+7FC0              YMAX     equ  254
   25+7FC0              YMIN     equ  0
   26+7FC0
   27+7FC0              ;XECUTE MOUSE
   28+7FC0              ;TAKE COORDINATES FROM CURPOS=
   29+7FC0              ;=COORD
   30+7FC0
   31+7FC0              MOUSE
   32+7FC0 2A 41 80              ld   hl,(COORD)
   33+7FC3              ;L=X-axis
   34+7FC3              ;H=Y-axis
   35+7FC3 01 DF FB              ld   bc,$FBDF
   36+7FC6 ED 5B 44 80           ld   de,(OLDCO)
   37+7FCA ED 78                 in   a,(c)
   38+7FCC 32 44 80              ld   (OLDCO),a
   39+7FCF 93                    sub  e
   40+7FD0 28 14                 jr   z,NM_X
   41+7FD2 F2 DC 7F              jp   p,MX_PL
   42+7FD5 85                    add  a,l
   43+7FD6 38 01                 jr   c,ZER_X
   44+7FD8 AF                    xor  a
   45+7FD9 6F           ZER_X    ld   l,a
   46+7FDA 18 0A                 jr   NM_X
   47+7FDC 85           MX_PL    add  a,l
   48+7FDD 38 04                 jr   c,BEX_Z
   49+7FDF FE 99                 cp   XMAX
   50+7FE1 38 02                 jr   c,BEX_B
   51+7FE3 3E 99        BEX_Z    ld   a,XMAX
   52+7FE5 6F           BEX_B    ld   l,a
   53+7FE6 06 FF        NM_X     ld   b,$FF
   54+7FE8 ED 78                 in   a,(c)
   55+7FEA 32 45 80              ld   (OLDCO+1),a
   56+7FED 92                    sub  d
   57+7FEE 28 16                 jr   z,NM_Y
   58+7FF0 ED 44                 neg
   59+7FF2 F2 FC 7F              jp   p,MY_PL
