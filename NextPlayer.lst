 4559 92E9              ; bit.7 sa nastavi vzdy, po odohrati vsetkych pozicii alebo po fadeoute
 4560 92E9              ; ...v jednoduchosti:	2 - fadeout after loop
 4561 92E9              ;			1 - no loop
 4562 92E9              ;			0 - loop forever
