  187+80FE
  188+80FE CD 7D 80             call MOUSE_UpdateSpr
  189+8101
  190+8101 21 48 80             ld hl, MOUSE_DCNT
  191+8104 7E                   ld a, (hl)
  192+8105 B7                   or a
