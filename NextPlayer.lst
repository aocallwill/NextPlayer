    1+8046              ; =============================================================================
    2+8046              ; mouse_support.asm  –  podpora Kempston myši pro NextPlayer
    3+8046              ; Autor: Shrek/MB Maniax  v0.9
    4+8046              ;
    5+8046              ; ZMĚNY v0.9:
    6+8046              ;  - MOUSE_PLAY_TICK přesunut ZA keysetup (byl před ním → keysetup přepisoval
    7+8046              ;    klavesa kterou MOUSE_PLAY_TICK nastavil)
    8+8046              ;  - Zpřesnění X hranic seznamu souborů (bylo 1..159, nyní 32..135)
    9+8046              ;    Zabrání kliknutí mimo levý panel (pravá část obrazovky, border)
   10+8046              ;  - MOUSE_PLAY_TICK vynuluje MOUSE_TLAC jen jednou, ne dvakrát
   11+8046              ; =============================================================================
   12+8046
   13+8046              MOUSE_PORT_BTN  equ $FADF
   14+8046
   15+8046              ; CSpect border offsets:
   16+8046              ; Nahoře:  32px → COORD+1 = ZX_pixel_Y + 32
   17+8046              ; Vlevo:   24px → COORD+0 = ZX_pixel_X + 24
   18+8046              MOUSE_BORDER_Y  equ 32
   19+8046              MOUSE_BORDER_X  equ 32
   20+8046
   21+8046              ; Oblast levého panelu (seznam souborů):
   22+8046              ; ZX pixel X: 32..111 (chars 4..13, šířka 10 chars = jméno souboru)
   23+8046              ; ZX pixel Y: 16..159 (chars 2..19, výška 18 řádků)
   24+8046              ; + border offsets:
   25+8046              MOUSE_LIST_Y0   equ 16 + MOUSE_BORDER_Y     ; = 48
   26+8046              MOUSE_LIST_Y1   equ 159 + MOUSE_BORDER_Y    ; = 191
   27+8046              MOUSE_LIST_X0   equ 24 ; + MOUSE_BORDER_X       ; = 40  (zacý okraj panelu)
   28+8046              MOUSE_LIST_X1   equ 68 ;+ MOUSE_BORDER_X    ; = 143 (pravy okraj leveho panelu)
   29+8046
   30+8046              ; Proměnné
   31+8046 00           MOUSE_TLAC      defb 0
   32+8047 00           MOUSE_WOLD      defb 0
   33+8048 00           MOUSE_DCNT      defb 0
   34+8049 FF           MOUSE_DROW      defb $FF
   35+804A 00           MOUSE_OLD_ROW   defb 0
   36+804B 00           MOUSE_NEW_ROW   defb 0
   37+804C
   38+804C              ; =============================================================================
   39+804C              ; MOUSE_INIT
   40+804C              ; =============================================================================
   41+804C              MOUSE_INIT:
   42+804C 21 00 00             ld hl, 0*256 + 0
   43+804F CD 2F 80             call KOREKCE
   44+8052
   45+8052 CD C2 80             call MOUSE_RdWheel
   46+8055 32 47 80             ld (MOUSE_WOLD), a
   47+8058
   48+8058 AF                   xor a
   49+8059 32 46 80             ld (MOUSE_TLAC), a
   50+805C 32 48 80             ld (MOUSE_DCNT), a
   51+805F 3E FF                ld a, $FF
   52+8061 32 49 80             ld (MOUSE_DROW), a
   53+8064
   54+8064 ED 91 15 41          nextreg $15, %01000001
   55+8068
   56+8068 ED 91 34 00          nextreg $34, 0
   57+806C 21 68 C6             ld hl, mouse_sipka_data
   58+806F 06 00                ld b, 0
   59+8071 0E 5B                ld c, $5B
   60+8073              MINIT_loop:
   61+8073 7E                   ld a, (hl)
