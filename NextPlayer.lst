  133+80CE              ; =============================================================================
  134+80CE              ; MOUSE_PLAY_TICK – myš při přehrávání
  135+80CE              ;
  136+80CE              ; Volat ZA keysetup, PŘED music_play (v každé přehrávací smyčce):
  137+80CE              ;   call keysetup
  138+80CE              ;   call MOUSE_PLAY_TICK    ← sem
  139+80CE              ;   call stc.music_play
  140+80CE              ;
  141+80CE              ; Pravé tlačítko (bit0) → klavesa = 1  = break/stop
  142+80CE              ; Levé tlačítko  (bit1) → klavesa = 32 = space/next
  143+80CE              ; =============================================================================
  144+80CE              MOUSE_PLAY_TICK:
  145+80CE F5                   push af
  146+80CF C5                   push bc
  147+80D0 E5                   push hl
  148+80D1
  149+80D1 CD 7D 80             call MOUSE_UpdateSpr
  150+80D4
  151+80D4 3A 46 80             ld a, (MOUSE_TLAC)
  152+80D7 B7                   or a
  153+80D8 28 1C                jr z, .done
  154+80DA
  155+80DA                      ; Pravé tlačítko = break
  156+80DA CB 47                bit 0, a
  157+80DC 28 0B                jr z, .checkLeft
  158+80DE AF                   xor a
  159+80DF 32 46 80             ld (MOUSE_TLAC), a
  160+80E2 3E 01                ld a, 1
  161+80E4 32 83 9A             ld (klavesa), a
  162+80E7 18 0D                jr .done
  163+80E9
  164+80E9              .checkLeft:
  165+80E9                      ; Levé tlačítko = next song
  166+80E9 CB 4F                bit 1, a
  167+80EB 28 09                jr z, .done
  168+80ED AF                   xor a
  169+80EE 32 46 80             ld (MOUSE_TLAC), a
  170+80F1 3E 20                ld a, 32
  171+80F3 32 83 9A             ld (klavesa), a
  172+80F6
  173+80F6              .done:
  174+80F6 E1                   pop hl
  175+80F7 C1                   pop bc
  176+80F8 F1                   pop af
  177+80F9 C9                   ret
  178+80FA
  179+80FA              ; =============================================================================
  180+80FA              ; MOUSE_TICK – hlavní smyčka (hl0, před KEYSCAN)
  181+80FA              ; =============================================================================
  182+80FA              MOUSE_TICK:
  183+80FA F5                   push af
  184+80FB C5                   push bc
  185+80FC D5                   push de
