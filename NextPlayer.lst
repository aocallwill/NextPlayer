 4053 7F32              ; --- Mouse driver + support (za font: aby font zustal pod $8000) ---
 4054 7F32              			INCLUDE "driver.a80"
# file opened: driver.a80
    1+7F32              ;   Nejprve zavolat KOREKCE s parametrama:
    2+7F32              ;           INPUT : L=new X-axis(0-255) / H=new Y-axis(0-191)
    3+7F32              ;           OUTPUT: none
    4+7F32              ;
    5+7F32              ;
    6+7F32              ;   Zavolat MOUSE - zjištění nových souřadnic:
    7+7F32              ;           INPUT : none
    8+7F32              ;           OUTPUT: A=buttons status (*) + modify mouse positions (*)
    9+7F32              ;
   10+7F32              ;           register L or (coord+0) = 1B new x-axis window position(absolute)
   11+7F32              ;           register H or (coord+1) = 1B new y-axis window position(absolute)
   12+7F32              ;
   13+7F32              ;           register A or (contrb)  = 1B new mouse buttons (D0=right button,D1=left button,D2=middle button) - 0=inactive/1=active button
   14+7F32              ;
   15+7F32              ;           register E or (oldco+0) = 1B previous(old) x-axis window position(absolute)
   16+7F32              ;           register D or (oldco+1) = 1B previous(old) y-axis window position(absolute)
   17+7F32              ;
   18+7F32              ;           register BC is modified, after return from driver will contain value #FADF.
   19+7F32
   20+7F32
   21+7F32              XMAX     equ  153
   22+7F32              XMIN     equ  0
   23+7F32
   24+7F32              YMAX     equ  254
   25+7F32              YMIN     equ  0
   26+7F32
   27+7F32              ;XECUTE MOUSE
   28+7F32              ;TAKE COORDINATES FROM CURPOS=
   29+7F32              ;=COORD
   30+7F32
   31+7F32              MOUSE
   32+7F32 2A B3 7F              ld   hl,(COORD)
   33+7F35              ;L=X-axis
   34+7F35              ;H=Y-axis
   35+7F35 01 DF FB              ld   bc,$FBDF
   36+7F38 ED 5B B6 7F           ld   de,(OLDCO)
   37+7F3C ED 78                 in   a,(c)
   38+7F3E 32 B6 7F              ld   (OLDCO),a
   39+7F41 93                    sub  e
   40+7F42 28 14                 jr   z,NM_X
   41+7F44 F2 4E 7F              jp   p,MX_PL
   42+7F47 85                    add  a,l
   43+7F48 38 01                 jr   c,ZER_X
   44+7F4A AF                    xor  a
   45+7F4B 6F           ZER_X    ld   l,a
   46+7F4C 18 0A                 jr   NM_X
   47+7F4E 85           MX_PL    add  a,l
   48+7F4F 38 04                 jr   c,BEX_Z
   49+7F51 FE 99                 cp   XMAX
   50+7F53 38 02                 jr   c,BEX_B
   51+7F55 3E 99        BEX_Z    ld   a,XMAX
   52+7F57 6F           BEX_B    ld   l,a
   53+7F58 06 FF        NM_X     ld   b,$FF
   54+7F5A ED 78                 in   a,(c)
   55+7F5C 32 B7 7F              ld   (OLDCO+1),a
   56+7F5F 92                    sub  d
   57+7F60 28 16                 jr   z,NM_Y
   58+7F62 ED 44                 neg
   59+7F64 F2 6E 7F              jp   p,MY_PL
   60+7F67 84                    add  a,h
   61+7F68 38 01                 jr   c,ZER_Y
   62+7F6A AF                    xor  a
   63+7F6B 67           ZER_Y    ld   h,a
   64+7F6C 18 0A                 jr   NM_Y
   65+7F6E 84           MY_PL    add  a,h
   66+7F6F 38 04                 jr   c,BEY_Z
   67+7F71 FE FE                 cp   YMAX
   68+7F73 38 02                 jr   c,BEY_B
   69+7F75 3E FE        BEY_Z    ld   a,YMAX
   70+7F77 67           BEY_B    ld   h,a
   71+7F78 7C           NM_Y     ld   a,h
   72+7F79 FE FF                 cp   $FF
   73+7F7B 38 02                 jr   c,BIGY
   74+7F7D 26 FF                 ld   h,$FF
   75+7F7F FE 00        BIGY     cp   YMIN
   76+7F81 30 02                 jr   nc,SMALY
   77+7F83 26 00                 ld   h,YMIN
   78+7F85 7D           SMALY    ld   a,l
   79+7F86 FE FF                 cp   $FF
   80+7F88 38 02                 jr   c,DIRY
   81+7F8A 2E FF                 ld   l,$FF
   82+7F8C FE 00        DIRY     cp   XMIN
   83+7F8E 30 02                 jr   nc,DIMENS
   84+7F90 2E 00                 ld   l,XMIN
   85+7F92 22 B3 7F     DIMENS   ld   (COORD),hl
   86+7F95 01 DF FA              ld   bc,$FADF
   87+7F98 ED 78                 in   a,(c)
   88+7F9A 2F                    cpl
   89+7F9B E6 07                 and  7
   90+7F9D 32 B5 7F              ld   (CONTRB),a
   91+7FA0 C9                    ret
   92+7FA1              ;------------------------------
   93+7FA1              ;INPUT: L=new X-axis
   94+7FA1              ;       H=new Y-axis
   95+7FA1
   96+7FA1 3E FB        KOREKCE  ld   a,$FB
   97+7FA3 DB DF                 in   a,($DF)
   98+7FA5 32 B6 7F              ld   (OLDCO),a
   99+7FA8 3E FF                 ld   a,$FF
  100+7FAA DB DF                 in   a,($DF)
  101+7FAC 32 B7 7F              ld   (OLDCO+1),a
  102+7FAF 22 B3 7F              ld   (COORD),hl
  103+7FB2 C9                    ret
  104+7FB3              ;------------------------------
  105+7FB3              ;new cursor position
  106+7FB3 00 00        COORD    defb 0,0
  107+7FB5
  108+7FB5              ;buttons status
  109+7FB5 00           CONTRB   defb 0
  110+7FB6
  111+7FB6              ;working (previous position)
  112+7FB6 00 00        OLDCO    defb 0,0
