 7610 A97D              ;------------------------------------------------------------------------------
 7611 A97D              	struct AR	; AY Registers structure
 7612 A97D ~            TonA		word	; 0
 7613 A97D ~            TonB		word	; 2
 7614 A97D ~            TonC		word	; 4
 7615 A97D ~            Noise		byte	; 6
 7616 A97D ~            Mixer		byte	; 7
 7617 A97D ~            AmplA		byte	; 8
 7618 A97D ~            AmplB		byte	; 9
 7619 A97D ~            AmplC		byte	; 10
 7620 A97D ~            Env		word	; 11
 7621 A97D ~            EnvSh		byte	; 13
 7622 A97D              	ends
 7623 A97D
 7624 A97D              	struct CHP	; channel parameters structure
 7625 A97D ~            EnvState	byte
 7626 A97D ~            PatStep		byte
 7627 A97D ~            SmpIndex	byte
 7628 A97D ~            Note		byte
 7629 A97D ~            PatStpCnt	byte
 7630 A97D ~            SmpPtr		word
 7631 A97D ~            OrnPtr		word
 7632 A97D ~            SmpCnt		byte
 7633 A97D              	ends
 7634 A97D
 7635 A97D              @HEADLEN = 27	; file header length
 7636 A97D              @SAMPLEN = 99	; single sample length
 7637 A97D              @ORNALEN = 33	; single ornament length
 7638 A97D              @PATTLEN = 7	; single pattern record length
 7639 A97D
 7640 A97D
 7641 A97D
 7642 A97D              			endmodule
